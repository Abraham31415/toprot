NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_DOC_SERVICE_URL=http://localhost:8001

RESEND_API_KEY=

# Tier 3 AI reviewer questions on the protocol quality panel (optional -- the
# panel degrades gracefully to "not configured" without this).
ANTHROPIC_API_KEY=

# AI usage and cost control (see supabase/migrations/20261109120000_ai_usage_credits.sql).
# Budget threshold alerts (50/75/90/100 percent of the daily platform budget) are emailed here
# through Resend. Limits, prices and budgets themselves live in the database (ai_settings,
# ai_model_pricing, ai_features), not in environment variables.
AI_ADMIN_ALERT_EMAIL=
AI_ALERT_FROM_EMAIL=

# Billing, preferred provider: Dodo Payments. See docs/billing.md. When DODO_PAYMENTS_API_KEY is set it is used instead of Flutterwave.
# Use the TEST key first (dodo_test_...). A live key is refused unless BILLING_LIVE_ENABLED=true.
DODO_PAYMENTS_API_KEY=
# The webhook signing secret (whsec_...) from Dodo > Developer > Webhooks. Webhooks are rejected without it.
DODO_PAYMENTS_WEBHOOK_SECRET=

# Billing (Flutterwave, dormant alternative). Leave blank to keep payments switched off.
# Use TEST keys first (FLWSECK_TEST-...). A live key is refused unless BILLING_LIVE_ENABLED=true.
FLW_SECRET_KEY=
# The "secret hash" you choose in Flutterwave Dashboard > Settings > Webhooks. Webhooks are rejected without it.
FLW_WEBHOOK_HASH=
BILLING_LIVE_ENABLED=
# Lets the scheduled job at /api/billing/maintenance run (Vercel Cron sends it as a Bearer token). 16+ random characters.
CRON_SECRET=

# Admin console (see docs/ADMIN.md).
# Two-step verification is required for administrators. Set to false ONLY while the Supabase project has multi-factor switched off.
ADMIN_MFA_REQUIRED=
# IANA timezone for "today", "this month" and charts, for example Africa/Kampala. Default UTC. AI budgets always use UTC days.
ADMIN_TIMEZONE=
# Secret salt for the daily visitor code used by first-party page tracking. Any long random string. Falls back to a value derived from the service key.
ANALYTICS_SALT=
# Optional: compare recorded AI cost with Anthropic's cost report. This is an ADMIN API key from the Anthropic Console, not the normal API key.
ANTHROPIC_ADMIN_API_KEY=
# Optional: list recent deployments on the System Health page.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
