NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_DOC_SERVICE_URL=http://localhost:8001

RESEND_API_KEY=

# Tier 3 AI reviewer questions on the protocol quality panel (optional -- the
# panel degrades gracefully to "not configured" without this).
ANTHROPIC_API_KEY=

# AI usage and cost control (see supabase/migrations/20261109120000_ai_usage_credits.sql).
# Budget threshold alerts (50/75/90/100 percent of the daily platform budget) are emailed here
# through Resend. Limits, prices and budgets themselves live in the database (ai_settings,
# ai_model_pricing, ai_features), not in environment variables.
AI_ADMIN_ALERT_EMAIL=
AI_ALERT_FROM_EMAIL=
